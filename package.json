{
  "name": "cail-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs --dist",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "check": "node --check worker/index.js && node --check scripts/build.mjs && node --check scripts/serve.mjs && node --check src/games.js",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  }
}
